{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "RCut",
	"version": "0.1.3",
	"identifier": "com.rcut.app",
	"build": {
		"devUrl": "http://localhost:3000",
		"frontendDist": "../../web/out",
		"beforeDevCommand": "bun run --filter @rcut/web dev",
		"beforeBuildCommand": "bun run --filter @rcut/web build"
	},
	"app": {
		"windows": [
			{
				"title": "RCut",
				"width": 1600,
				"height": 900,
				"minWidth": 1100,
				"minHeight": 700,
				"resizable": true,
				"dragDropEnabled": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": ["nsis"],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../../../LICENSE": "LICENSE",
			"../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
		},
		"windows": {
			"nsis": {
				"installerIcon": "icons/icon.ico"
			}
		}
	}
}
